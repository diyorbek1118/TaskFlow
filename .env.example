# Laravel Docker Universal Configuration
# Copy this file to .env and customize for your project

# Project Configuration
PROJECT_NAME=myapp
PROJECT_PATH=./laravel_project

# PHP Version (8.1, 8.2, 8.3)
PHP_VERSION=8.2

# Application Ports
APP_PORT=8080
DB_PORT=3306
REDIS_PORT=6379

# Database Configuration
MYSQL_VERSION=8.0
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# User IDs (run 'id -u' and 'id -g' to get your values)
UID=1000
GID=1000
